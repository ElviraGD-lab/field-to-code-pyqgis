repository-code: "https://github.com/ElviraGD-lab/field-to-code-pyqgis"
url: "https://elviragd-lab.github.io/field-to-code-pyqgis/"
keywords:
  - QGIS
  - PyQGIS
  - power lines
  - emergency response
  - exposure analysis
  - open data
